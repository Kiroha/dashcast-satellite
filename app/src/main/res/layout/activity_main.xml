<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/AppTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="30sp" android:textColor="#58D6BE" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/subtitle" android:textSize="16sp" android:layout_marginBottom="24dp" />
        <TextView style="@style/SectionTitle" android:text="@string/pairing_section" />
        <TextView style="@style/Body" android:text="@string/pairing_help" />
        <TextView android:id="@+id/pairing_state" style="@style/Body" />
        <Button android:id="@+id/import_pairing" style="@style/Action" android:text="@string/import_pairing" />
        <Button android:id="@+id/forget_pairing" style="@style/Action" android:text="@string/forget_pairing" />
        <TextView style="@style/SectionTitle" android:text="@string/source_section" />
        <RadioGroup android:id="@+id/source_choice" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/maps" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/source_maps" />
            <RadioButton android:id="@+id/abrp" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/source_abrp" />
        </RadioGroup>
        <TextView style="@style/Body" android:text="@string/source_help" />
        <TextView android:id="@+id/access_state" style="@style/Body" />
        <Button android:id="@+id/grant_access" style="@style/Action" android:text="@string/grant_access" />
        <TextView style="@style/SectionTitle" android:text="@string/session_section" />
        <TextView android:id="@+id/connection_state" style="@style/Body" />
        <TextView android:id="@+id/source_state" style="@style/Body" />
        <TextView android:id="@+id/receiver_state" style="@style/Body" />
        <Button android:id="@+id/start" style="@style/Action" android:text="@string/start" />
        <Button android:id="@+id/stop" style="@style/Action" android:text="@string/stop" />
        <CheckBox android:id="@+id/restart_after_boot" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/restart_after_boot" />
        <TextView style="@style/Body" android:text="@string/receiver_help" />
        <TextView style="@style/SectionTitle" android:text="@string/device_section" />
        <TextView android:id="@+id/device_info" style="@style/Body" android:textIsSelectable="true" />
        <TextView style="@style/Body" android:text="@string/video_pending" android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
