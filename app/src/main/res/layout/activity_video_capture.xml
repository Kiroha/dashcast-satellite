<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/SectionTitle" android:text="@string/video_title" />
        <TextView android:id="@+id/video_help" style="@style/Body" />
        <TextView style="@style/Body" android:text="@string/video_privacy" />
        <TextView android:id="@+id/video_application" style="@style/Body" />
        <Button android:id="@+id/video_choose" style="@style/Action" android:text="@string/video_choose" />
        <Button android:id="@+id/video_open_app" style="@style/Action" android:text="@string/video_open_app" />
        <TextView android:id="@+id/video_status" style="@style/Body" />
        <Button android:id="@+id/video_start" style="@style/Action" android:text="@string/video_start" />
        <Button android:id="@+id/video_stop" style="@style/Action" android:text="@string/video_stop" />
        <TextView android:id="@+id/video_metrics" style="@style/Body" />
        <TextView style="@style/Body" android:text="@string/video_performance" />
    </LinearLayout>
</ScrollView>
